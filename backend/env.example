# WCAG Accessibility Remediation Platform Configuration
# Never put live credentials in this tracked example. Copy it to the ignored
# backend/.env for local development, or use Vercel/project secret storage.

# Application
# Keep "testing" for the current open test deployment. "trial" fails closed:
# DISABLE_AUTH must be False and every Supabase variable below must be set.
DEPLOYMENT_MODE=testing
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Processing limits
MAX_FILE_SIZE_MB=50
MAX_PAGES_PDF=100

# LayoutLMv3 fine-tuned model directory
LAYOUTLM_MODEL_DIR=./layoutLM_trained

# Playwright settings
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT=30000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication & Database
SECRET_KEY=change_me_to_a_secure_random_string_in_production
DATABASE_URL=sqlite:///./wcag_platform.db
# Testing mode permits True for the current bypass; trial mode requires False.
DISABLE_AUTH=True

# Supabase trial identity and storage (optional in testing, required in trial).
# These are non-secret placeholders; use project-specific deployment values.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_value
SUPABASE_SECRET_KEY=replace_with_backend_only_secret
SUPABASE_PROJECT_REF=example-project
SUPABASE_ORIGINALS_BUCKET=trial-originals
SUPABASE_RESULTS_BUCKET=trial-results
SUPABASE_STORAGE_CONNECT_TIMEOUT_SECONDS=5
SUPABASE_STORAGE_READ_TIMEOUT_SECONDS=30
SUPABASE_STORAGE_WRITE_TIMEOUT_SECONDS=30
SUPABASE_STORAGE_POOL_TIMEOUT_SECONDS=5
SUPABASE_STORAGE_SIGNED_URL_SECONDS=300

# OpenID Connect (OIDC) Authentication settings
OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret
OIDC_DISCOVERY_URL=https://your-identity-provider/.well-known/openid-configuration

# Document retention policy (in hours, between 2 and 24)
RETENTION_PERIOD_HOURS=12

# AI Alt-text generation
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Ambiguous PDF Unicode verification (Gemini vision)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
PDF_UNICODE_LLM_ENABLED=true
PDF_UNICODE_LLM_MAX_ATTEMPTS=3
PDF_UNICODE_LLM_MIN_CONFIDENCE=0.98
PDF_UNICODE_LLM_TIMEOUT_SECONDS=45
PDF_UNICODE_LLM_MAX_OCCURRENCES=3





