# PDFAccess trial deployment example.
# Copy into the pdfaccess.org Vercel project only. Do not use live secrets here.

APP_NAME=PDFAccess
DEPLOYMENT_MODE=trial
DEBUG=false
DISABLE_AUTH=false
SECRET_KEY=replace-with-trial-only-random-secret

PUBLIC_SITE_URL=https://pdfaccess.org
PUBLIC_APP_ORIGIN=https://pdfaccess.org
PRIMARY_DOMAIN=pdfaccess.org
CORS_ORIGINS_LIST=https://pdfaccess.org

DATABASE_URL=postgresql://pdfaccess_trial_user:replace-password@trial-db.example.invalid:5432/pdfaccess_trial
ARTIFACT_STORAGE_ROOT=/tmp/pdfaccess-trial-artifacts

SUPABASE_PROJECT_REF=pdfaccesstrialexample
SUPABASE_URL=https://pdfaccesstrialexample.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-trial-publishable-key
SUPABASE_SECRET_KEY=replace-with-trial-service-role-secret
SUPABASE_ORIGINALS_BUCKET=pdfaccess-trial-originals
SUPABASE_RESULTS_BUCKET=pdfaccess-trial-results
SUPABASE_STORAGE_SIGNED_URL_SECONDS=300

RETENTION_PERIOD_HOURS=12
MAX_FILE_SIZE_MB=50
MAX_PAGES_PDF=100
PDF_SUBPROCESS_TIMEOUT_SECONDS=180

RESEND_API_KEY=replace-with-trial-resend-api-key
RESEND_FROM_EMAIL=PDFAccess <support@pdfaccess.org>
RESEND_REPLY_TO=support@pdfaccess.org
SUPABASE_AUTH_SMTP_SENDER=support@pdfaccess.org
SUPABASE_AUTH_SMTP_HOST=smtp.resend.com
SUPABASE_AUTH_SMTP_PORT=587

SUPPORT_EMAIL=support@pdfaccess.org
