# WCAG Accessibility Remediation Platform Configuration

# Application
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Processing limits
MAX_FILE_SIZE_MB=50
MAX_PAGES_PDF=100

# OpenDataLoader local checkout (optional)
OPENDATALOADER_ROOT=./opendataloader-pdf-main

# Playwright settings
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT=30000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173





