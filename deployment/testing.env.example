# PDFAccess direct-testing deployment example.
# Copy into the wcag-remediation.vercel.app Vercel project only.

APP_NAME=PDFAccess Testing
DEPLOYMENT_MODE=testing
DEBUG=true
DISABLE_AUTH=true
SECRET_KEY=replace-with-testing-only-random-secret

PUBLIC_SITE_URL=https://wcag-remediation.vercel.app
PUBLIC_APP_ORIGIN=https://wcag-remediation.vercel.app
PRIMARY_DOMAIN=wcag-remediation.vercel.app
CORS_ORIGINS_LIST=https://wcag-remediation.vercel.app,http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql://pdfaccess_testing_user:replace-password@testing-db.example.invalid:5432/pdfaccess_testing
ARTIFACT_STORAGE_ROOT=/tmp/pdfaccess-testing-artifacts

SUPABASE_PROJECT_REF=pdfaccesstestingexample
SUPABASE_URL=https://pdfaccesstestingexample.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-testing-publishable-key
SUPABASE_SECRET_KEY=replace-with-testing-service-role-secret
SUPABASE_ORIGINALS_BUCKET=pdfaccess-testing-originals
SUPABASE_RESULTS_BUCKET=pdfaccess-testing-results
SUPABASE_STORAGE_SIGNED_URL_SECONDS=300

RETENTION_PERIOD_HOURS=12
MAX_FILE_SIZE_MB=50
MAX_PAGES_PDF=100
PDF_SUBPROCESS_TIMEOUT_SECONDS=180

RESEND_API_KEY=replace-with-testing-resend-api-key
RESEND_FROM_EMAIL=PDFAccess Testing <support@pdfaccess.org>
RESEND_REPLY_TO=support@pdfaccess.org
SUPABASE_AUTH_SMTP_SENDER=support@pdfaccess.org
SUPABASE_AUTH_SMTP_HOST=smtp.resend.com
SUPABASE_AUTH_SMTP_PORT=587

SUPPORT_EMAIL=support@pdfaccess.org
